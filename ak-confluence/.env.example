# Copy to .env and fill in. The VITE_ vars are public (shipped in the browser bundle).
VITE_SANITY_PROJECT_ID=3gzdej0i
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01

# SECRET — local scripts only (migration, CORS/dataset setup). Never commit a real value.
SANITY_WRITE_TOKEN=

# SECRET — used by the Cloudflare Pages Function at functions/api/contact.js to send
# contact-form emails via Resend (resend.com). Set the real value in the Cloudflare
# Pages dashboard (Settings > Environment variables), not just here.
RESEND_API_KEY=
